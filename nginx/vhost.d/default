# NOTE: Do NOT add a `location ^~ /.well-known/acme-challenge/` block here.
# acme-companion injects its OWN identical block into this same file at runtime
# (marked "## Start of configuration add by letsencrypt container"). A static
# copy here produces two identical locations in every vhost, which makes nginx
# fail to load with `duplicate location "/.well-known/acme-challenge/"` — taking
# ALL sites down and silently blocking every reload (so new vhosts never
# activate). acme-companion's block already serves challenges from
# /usr/share/nginx/html, so nothing extra is needed.

client_max_body_size 8192m;

# Allow large uploads (e.g. 6 GB static site zips) to transfer without timing out.
proxy_read_timeout 3600s;
proxy_send_timeout 3600s;
client_body_timeout 3600s;
